conn_state:  CLOSED, LISTEN, SYN_RCVD, ESTABLISHED, CLOSE_WAIT
flags:       RST, SYN, SYNACK, FIN_ACK, ACK, NONE
port_match:  exact, listen_only, no_match
payload:     none, some, bad_seq
checksum:    valid, invalid
header:      valid, short_frame, bad_doff, doff_overrun

# --- Constraints ---

# Invalid header: pin other params to canonical values (identical drop outcomes)
IF [header] <> "valid" THEN [conn_state] = "CLOSED"
    AND [flags] = "ACK" AND [port_match] = "no_match"
    AND [payload] = "none" AND [checksum] = "valid";

# Invalid checksum: pin other params to canonical values
IF [checksum] = "invalid" THEN [conn_state] = "CLOSED"
    AND [flags] = "ACK" AND [port_match] = "no_match"
    AND [payload] = "none" AND [header] = "valid";

# port_match constraints
IF [port_match] = "exact" THEN [conn_state] IN {"SYN_RCVD", "ESTABLISHED", "CLOSE_WAIT"};
IF [port_match] = "listen_only" THEN [conn_state] IN {"LISTEN", "CLOSED"};
IF [port_match] = "no_match" THEN [conn_state] = "CLOSED";

# payload constraints
IF [payload] = "bad_seq" THEN [conn_state] = "ESTABLISHED"
    AND [flags] = "ACK" AND [port_match] = "exact";
IF [payload] IN {"some", "bad_seq"} THEN [header] = "valid" AND [checksum] = "valid";
